{
  "name": "sui-onramp-api",
  "version": "0.1.0",
  "private": true,
  "description": "Fiat onramp proxy for Sui mobile wallets. Wraps Alchemy Pay's merchant API so client apps never hold the merchant secret; signs partner API calls server-side and exposes a small set of normalized endpoints.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test ALCHEMY_PAY_APP_ID=test-app-id ALCHEMY_PAY_APP_SECRET=test-secret-do-not-use ALCHEMY_PAY_BASE_URL=https://openapi-test.alchemypay.org USE_STUB_CRYPTO_LIST=true node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:live": "NODE_ENV=test ALCHEMY_PAY_APP_ID=test-app-id ALCHEMY_PAY_APP_SECRET=test-secret-do-not-use ALCHEMY_PAY_BASE_URL=https://openapi-test.alchemypay.org USE_STUB_CRYPTO_LIST=false node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
