# --- Server ---
PORT=8080
NODE_ENV=development

# --- Alchemy Pay merchant credentials ---
# Get these from the Alchemy Pay merchant dashboard after KYB approval.
# NEVER commit real values. Set them in your deployment platform's env (App Runner / Cloud Run / Vercel / etc.).
ALCHEMY_PAY_APP_ID=
ALCHEMY_PAY_APP_SECRET=

# Production: https://openapi.alchemypay.org
# Sandbox:    https://openapi-test.alchemypay.org
ALCHEMY_PAY_BASE_URL=https://openapi-test.alchemypay.org

# Dev stand-in while the Alchemy merchant account is still pending activation.
# When `true`, /buy/crypto-list returns a static list of common Sui-mainnet
# buyable coins instead of hitting Alchemy. Flip to `false` (or remove) once
# your merchant API access is live.
USE_STUB_CRYPTO_LIST=true

# --- Hosted-ramp redirect/callback (fixed for our app) ---
# Set server-side so the client can never supply them (prevents minting a
# merchant-signed ramp URL that redirects/callbacks to an attacker domain).
# Leave unset to let Alchemy's hosted page use its own defaults.
# RAMP_REDIRECT_URL=https://your-app.example/ramp/done
# RAMP_CALLBACK_URL=https://api.your-app.example/ramp/callback

# --- Debugging ---
# Logs the HMAC sign input + signature for local signature debugging only.
# MUST stay false/unset in production — never log signing material.
DEBUG_SIGN=false

# --- Rate limiting (per-IP, in-memory, fixed window) ---
# Set a *_MAX to 0 to disable that limiter. Mobile clients behind carrier NAT
# share IPs, so keep the global limit generous.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_MAX_WRITE=60

# --- Caching ---
# TTL (ms) for the slow-changing list endpoints (esp. the /sell/crypto-list
# per-coin quote fan-out). 0 disables caching.
CACHE_TTL_MS=30000
